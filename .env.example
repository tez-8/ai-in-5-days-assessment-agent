# Google Cloud & Gemini Platform Runtime Configuration (No hardcoded secrets)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=us-central1
GOOGLE_GENAI_USE_ENTERPRISE=True

# Model Routing Configuration (Rubric 3-2)
FAST_TRIAGE_MODEL=gemini-2.5-flash
DEEP_PLANNING_MODEL=gemini-2.5-pro

# Observability, Secret Manager & DLP Redaction Flags (Rubric Categories 4 & 5)
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
ENABLE_SECRET_MANAGER_LOOKUP=true
ENABLE_CLOUD_DLP_REDACTION=false
FIRESTORE_DATABASE_ID=(default)
